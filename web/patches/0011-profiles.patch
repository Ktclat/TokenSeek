-/** 草稿只保存在本次页面的内存中，独立于会话详情缓存；null 是新对话的草稿。 */
+/** 草稿属于当前档案，独立于会话详情缓存；null 是新对话的草稿。 */
 export const useDrafts = create<{ drafts: Map<string | null, Draft> }>(() => ({
   drafts: new Map(),
 }))
 
+export type DraftSnapshot = {
+  drafts: Map<string | null, Draft>
+  uploads: Record<string, UploadTask>
+}
+
+export const snapshotDrafts = (): DraftSnapshot => {
+  const { drafts } = useDrafts.getState()
+  const { tasks } = useUploads.getState()
+  const uploads: Record<string, UploadTask> = {}
+  for (const draft of drafts.values()) {
+    for (const { id } of draft.attachments) {
+      const task = tasks[id]
+      // The network request cannot survive a reload. Keep the File so the user can retry.
+      uploads[id] = task && task.status !== 'uploading' ? task
+        : { status: 'error', retryable: true, error: { key: 'uploadFileStatusFailed' } }
+    }
+  }
+  return { drafts, uploads }
+}
+
+export const restoreDrafts = (snapshot: DraftSnapshot, sessionIds: Set<string>) => {
+  const drafts = new Map<string | null, Draft>()
+  const tasks: Record<string, UploadTask> = {}
+  for (const [id, draft] of snapshot.drafts) {
+    if (id !== null && !sessionIds.has(id)) continue
+    drafts.set(id, draft)
+    for (const file of draft.attachments) tasks[file.id] = snapshot.uploads[file.id]
+  }
+  useUploads.setState({ tasks })
+  useDrafts.setState({ drafts })
+}
+
 export const getDraft = (sessionId: string | null): Draft =>
   useDrafts.getState().drafts.get(sessionId) ?? EMPTY_DRAFT
 
