+      const files = tx.objectStore('files')
+      const staged = tx.objectStore('sessionsStaging')
+      const originals = tx.objectStore('filesStaging')
+      const ids = new Map<string, string>()
+      for (let cursor = await staged.openCursor(); cursor; cursor = await cursor.continue()) {
+        const session = cursor.value
+        if (known.has(session.id) || await sessions.getKey(session.id) !== undefined) continue
+        for (const message of session.messages) {
+          if (message.role !== 'user') continue
+          for (const file of message.files) {
+            let id = ids.get(file.id)
+            if (!id) {
+              id = createId()
+              ids.set(file.id, id)
+              const original = await originals.get(file.id)
+              if (original) await files.add({ id, blob: original.blob })
+            }
+            file.id = id
