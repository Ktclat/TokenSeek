+        await tx.objectStore('sessionSummaries').add(summary)
+        added.push(toSessionSummary(summary))
+      }
+      const store = tx.objectStore('organization')
+      const local = parseOrganization(await store.get('current'))
+      const incoming = parseOrganization(organization, new Set(added.map(item => item.id)))
+      const projects = new Set(local.projects.map(project => project.id))
+      await store.put({
+        projects: local.projects.concat(incoming.projects.filter(project => !projects.has(project.id))),
