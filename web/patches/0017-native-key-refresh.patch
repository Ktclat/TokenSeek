-export function changeKey(action: Exclude<KeyAction, 'read'>, id = '', name = '', secret = '') {
+export function changeKey(action: KeyAction, id = '', name = '', secret = '') {
   const result = accessKeys(action, id, name, secret)
   if (!result) return false
   const { activeId, entries, apiKey } = result
+  if (action === 'read') {
+    const current = useSettings.getState()
+    const ring = current.keyRing
+    if (current.apiKey === apiKey && ring.activeId === activeId && ring.entries.length === entries.length
+        && entries.every((entry, i) => {
+          const old = ring.entries[i]
+          return old.id === entry.id && old.name === entry.name && old.suffix === entry.suffix
+        })) return true
+  }
   useSettings.setState({ apiKey, keyRing: { activeId, entries } })
   return true
 }
